+package net.minecraft.world.entity.projectile.throwableitemprojectile;
+
+import net.minecraft.core.particles.ParticleTypes;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.Identifier;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityEvent;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.monster.Blaze;
+import net.minecraft.world.item.Item;
+import net.minecraft.world.item.ItemStack;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.EntityHitResult;
+import net.minecraft.world.phys.HitResult;
+
+// MineAzur — shuriken (portage de net.minecraft.server.EntityShuriken du jar 2011 patché).
+// Projectile-item : 6 dégâts (+3 vs Blaze), particules de fumée, meurt à l'impact.
+public class MineazurShurikenEntity extends ThrowableItemProjectile {
+    // Renseigné par le générateur (MineazurGeneratedContent.registerEntities) au chargement.
+    public static EntityType<MineazurShurikenEntity> TYPE;
+
+    public MineazurShurikenEntity(final EntityType<? extends MineazurShurikenEntity> type, final Level level) {
+        super(type, level);
+    }
+
+    public MineazurShurikenEntity(final Level level, final LivingEntity mob, final ItemStack itemStack) {
+        super(TYPE, mob, level, itemStack);
+    }
+
+    @Override
+    public Item getDefaultItem() {
+        final Item item = BuiltInRegistries.ITEM.getValue(Identifier.fromNamespaceAndPath("mineazur", "shuriken"));
+        return item != null ? item : Items_IRON_INGOT();
+    }
+
+    private static Item Items_IRON_INGOT() {
+        return BuiltInRegistries.ITEM.getValue(Identifier.withDefaultNamespace("iron_ingot"));
+    }
+
+    @Override
+    protected void onHitEntity(final EntityHitResult hitResult) {
+        super.onHitEntity(hitResult);
+        final Entity entity = hitResult.getEntity();
+        final int damage = entity instanceof Blaze ? 9 : 6; // 2011 : 6 partout, +3 vs Blaze
+        entity.hurt(this.damageSources().thrown(this, this.getOwner()), damage);
+    }
+
+    @Override
+    protected void onHit(final HitResult hitResult) {
+        super.onHit(hitResult);
+        if (!this.level().isClientSide()) {
+            this.level().broadcastEntityEvent(this, EntityEvent.DEATH);
+            this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.HIT);
+        }
+    }
+
+    @Override
+    public void handleEntityEvent(final byte id) {
+        if (id == EntityEvent.DEATH) {
+            for (int i = 0; i < 8; i++) {
+                this.level().addParticle(ParticleTypes.SMOKE, this.getX(), this.getY(), this.getZ(), 0.0, 0.0, 0.0);
+            }
+        }
+    }
+}
