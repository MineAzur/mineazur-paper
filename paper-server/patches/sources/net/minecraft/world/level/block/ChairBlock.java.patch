+package net.minecraft.world.level.block;
+
+import com.mojang.serialization.MapCodec;
+import java.util.List;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.InteractionResult;
+import net.minecraft.world.entity.EntitySpawnReason;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.decoration.ArmorStand;
+import net.minecraft.world.entity.player.Player;
+import net.minecraft.world.item.context.BlockPlaceContext;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.StateDefinition;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.BlockHitResult;
+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.phys.shapes.CollisionContext;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+
+// MineAzur — prototype Phase 1 : portage du bloc custom 1.2.5 "chair" (ID 202, tboss.SBTBlocks.BlockChair).
+// Comportements d'origine préservés : hitbox réduite 0.15-0.85 (xz), pleine hauteur ; directionnel yaw->facing.
+//
+// ⚠️ S'ASSEOIR est une FONCTIONNALITÉ NOUVELLE (2026-07-16, demandée) — PAS une restauration : BlockChair de
+// 2011 ne contenait que ses bornes et son orientation, aucune interaction. Cf. docs/reference/blocs/CHAIR_ASSISE.md.
+public class ChairBlock extends HorizontalDirectionalBlock {
+    public static final MapCodec<ChairBlock> CODEC = simpleCodec(ChairBlock::new);
+
+    // 1.2.5 BlockChair.a(...) : setBlockBounds(0.15F, 0.0F, 0.15F, 0.85F, 1.0F, 0.85F)
+    private static final VoxelShape SHAPE = Shapes.box(0.15D, 0.0D, 0.15D, 0.85D, 1.0D, 0.85D);
+
+    // --- Assise ------------------------------------------------------------------------------------------------
+    // Il n'existe AUCUN état « assis » en Minecraft : un joueur assis est un joueur qui CHEVAUCHE quelque chose.
+    // Le porteur doit donc être une entité, invisible, immobile, et que le client REÇOIVE (sans quoi il ne peut
+    // pas y attacher le joueur).
+    //
+    // ⛔ `Marker` est EXCLU malgré son nom : canAddPassenger() renvoie false et getAddEntityPacket() lève
+    //    « Markers should never be sent » (Marker.java). Le candidat le plus léger est interdit par construction.
+    // ✅ ArmorStand en mode MARKER : dimensions 0×0 (ArmorStand.MARKER_DIMENSIONS), donc pas de hitbox, pas de
+    //    collision — et comme l'attache PASSENGER a pour repli AT_HEIGHT (EntityAttachment.java:7), une hauteur
+    //    nulle place le joueur EXACTEMENT à la position du porteur. On le pose donc où l'on veut le joueur.
+    // On garde le type VANILLA : un EntityType custom devrait être miroité côté client et décalerait les IDs.
+    public static final String TAG_SIEGE = "mineazur_siege";
+
+    // Réglé à l'œil en jeu. L'assise est à 0.548 (cf. gen_geometry) ; la pose assise descend le corps sous
+    // l'origine du joueur, d'où ce retrait empirique. Trop haut = le joueur flotte, trop bas = il s'enfonce
+    // dans le siège. 0.30 puis 0.42 s'enfonçaient encore un poil (2026-07-17) → aligné sur l'assise 0.55.
+    private static final double HAUTEUR_ASSISE = 0.55D;
+
+    public ChairBlock(final BlockBehaviour.Properties properties) {
+        super(properties);
+        this.registerDefaultState(this.stateDefinition.any().setValue(FACING, Direction.NORTH));
+    }
+
+    @Override
+    protected MapCodec<ChairBlock> codec() {
+        return CODEC;
+    }
+
+    @Override
+    protected VoxelShape getShape(final BlockState state, final BlockGetter level, final BlockPos pos, final CollisionContext context) {
+        return SHAPE;
+    }
+
+    // Rayon (depuis le centre du bloc, en XZ) sous lequel le point d'impact est jugé « trop centré » pour
+    // trancher un axe -> on retombe sur l'orientation « face au placeur ».
+    private static final double SEUIL_CENTRE = 0.12D;
+
+    @Override
+    public BlockState getStateForPlacement(final BlockPlaceContext context) {
+        // MineAzur (2026-07-17) : orientation dérivée du POINT VISÉ sur le bloc cible, pas du yaw du joueur.
+        // FACING = côté du DOSSIER = direction où l'on pointe sur la surface ; on s'assoit à l'opposé
+        // (cf. useWithoutItem). Repli sur l'ancien comportement « dossier face au placeur » (1.2.5
+        // BlockChair.postPlace, dérivé du yaw) quand la visée est trop proche du centre pour être tranchée.
+        return this.defaultBlockState().setValue(FACING, orientationDepuisVisee(context));
+    }
+
+    private static Direction orientationDepuisVisee(final BlockPlaceContext context) {
+        final BlockPos pos = context.getClickedPos();
+        final Vec3 hit = context.getClickLocation();
+        final double dx = hit.x - (pos.getX() + 0.5D);
+        final double dz = hit.z - (pos.getZ() + 0.5D);
+        if (Math.max(Math.abs(dx), Math.abs(dz)) < SEUIL_CENTRE) {
+            return context.getHorizontalDirection().getOpposite();
+        }
+        // Quadrant par diagonale : l'axe horizontal dominant du vecteur centre->impact donne le côté du dossier.
+        if (Math.abs(dx) >= Math.abs(dz)) {
+            return dx > 0.0D ? Direction.EAST : Direction.WEST;
+        }
+        return dz > 0.0D ? Direction.SOUTH : Direction.NORTH;
+    }
+
+    @Override
+    protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
+        builder.add(FACING);
+    }
+
+    @Override
+    protected InteractionResult useWithoutItem(
+        final BlockState state, final Level level, final BlockPos pos, final Player player, final BlockHitResult hitResult
+    ) {
+        // S'accroupir laisse passer : sinon on ne pourrait plus poser un bloc contre une chaise.
+        if (player.isShiftKeyDown() || player.isPassenger()) {
+            return InteractionResult.PASS;
+        }
+        if (level.isClientSide()) {
+            return InteractionResult.SUCCESS;
+        }
+        if (chaiseOccupee(level, pos)) {
+            return InteractionResult.PASS;
+        }
+
+        final ArmorStand siege = EntityType.ARMOR_STAND.create(level, EntitySpawnReason.TRIGGERED);
+        if (siege == null) {
+            return InteractionResult.PASS;
+        }
+        siege.setPos(pos.getX() + 0.5D, pos.getY() + HAUTEUR_ASSISE, pos.getZ() + 0.5D);
+        siege.setMarker(true);       // dimensions 0×0 : ni hitbox ni collision, et l'attache tombe sur sa position
+        siege.setInvisible(true);
+        siege.setNoGravity(true);
+        siege.setSilent(true);
+        siege.setInvulnerable(true);
+        siege.addTag(TAG_SIEGE);     // sauvegardé avec l'entité -> survit à un redémarrage, d'où le ménage (cf. ArmorStand.tick)
+        // Le joueur regarde dans le sens de la chaise (FACING = le dossier fait face au joueur qui l'a posée,
+        // donc on s'assoit en regardant à l'OPPOSÉ du dossier).
+        siege.setYRot(state.getValue(FACING).getOpposite().toYRot());
+        level.addFreshEntity(siege);
+
+        if (!player.startRiding(siege, true, true)) {
+            siege.discard();   // pas de porteur orphelin si le chevauchement échoue
+            return InteractionResult.PASS;
+        }
+        return InteractionResult.CONSUME;
+    }
+
+    // Une chaise est occupée s'il reste un porteur dessus. Inutile de vérifier qu'il a un passager : un porteur
+    // sans passager se supprime au tick suivant (cf. le ménage dans ArmorStand.tick).
+    private static boolean chaiseOccupee(final Level level, final BlockPos pos) {
+        final List<ArmorStand> sieges = level.getEntitiesOfClass(
+            ArmorStand.class, new AABB(pos), a -> a.entityTags().contains(TAG_SIEGE));
+        return !sieges.isEmpty();
+    }
+}
