+package net.minecraft.world.level.block;
+
+import com.mojang.serialization.MapCodec;
+import net.minecraft.core.Direction;
+import net.minecraft.world.item.context.BlockPlaceContext;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.StateDefinition;
+
+// MineAzur — archétype "simple directionnel" (cube plein orienté selon le joueur). Ex : toit (204).
+// Shape par défaut = cube plein (pas d'override getShape). Codec simple (constructeur (Properties) seul).
+public class MineazurHorizontalBlock extends HorizontalDirectionalBlock {
+    public static final MapCodec<MineazurHorizontalBlock> CODEC = simpleCodec(MineazurHorizontalBlock::new);
+
+    public MineazurHorizontalBlock(final BlockBehaviour.Properties properties) {
+        super(properties);
+        this.registerDefaultState(this.stateDefinition.any().setValue(FACING, Direction.NORTH));
+    }
+
+    @Override
+    protected MapCodec<MineazurHorizontalBlock> codec() {
+        return CODEC;
+    }
+
+    @Override
+    public BlockState getStateForPlacement(final BlockPlaceContext context) {
+        // 1.2.5 BlockToit.postPlace : regard EST -> meta 0, et meta 0 = « droite est » (RenderBlocks), soit une
+        // pente montant vers l'EST. Idem sur les 4 : la pente monte DANS la direction du regard (elle s'éloigne
+        // du joueur, sa surface inclinée lui fait face). FACING = direction de la pente (= dirFromLegacy du
+        // replay) -> pas de getOpposite() ici, contrairement à chair (dont le siège, lui, fait face au joueur).
+        return this.defaultBlockState().setValue(FACING, context.getHorizontalDirection());
+    }
+
+    @Override
+    protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
+        builder.add(FACING);
+    }
+}
