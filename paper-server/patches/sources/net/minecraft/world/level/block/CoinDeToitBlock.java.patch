+package net.minecraft.world.level.block;
+
+import com.mojang.serialization.MapCodec;
+import java.util.EnumMap;
+import java.util.Map;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.world.item.context.BlockPlaceContext;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.StateDefinition;
+import net.minecraft.world.phys.Vec3;
+import net.minecraft.world.phys.shapes.CollisionContext;
+import net.minecraft.world.phys.shapes.Shapes;
+import net.minecraft.world.phys.shapes.VoxelShape;
+
+// MineAzur — Lot B de la MAJ Zehir 2012 : "coin_de_toit" (210), jamais déployé en 2011. Complément du bloc
+// "toit" (204) : escalier diagonal qui se rétracte vers un coin, une orientation par coin.
+// Géométrie transcrite de legacy/Maj de zehir/RenderBlocks.java#renderBlockCoinToit (renderType 34).
+//
+// Le fragment écrit les 4 orientations à la main (l=0..3) ; on les regénère à partir d'une règle unique, ce
+// qui est strictement équivalent (vérifié boîte à boîte) et évite 40 lignes de constantes recopiées :
+//   dalle pleine (k=0), puis 9 marches k=1..9 de hauteur 0.1 qui reculent de k/10 depuis les DEUX faces
+//   opposées au coin plein. Le coin plein est l'intersection de FACING et FACING.getClockWise() :
+//   NORTH->(x=1,z=0) = l0 ; EAST->(1,1) = l2 ; SOUTH->(0,1) = l1 ; WEST->(0,0) = l3.
+public class CoinDeToitBlock extends HorizontalDirectionalBlock {
+    public static final MapCodec<CoinDeToitBlock> CODEC = simpleCodec(CoinDeToitBlock::new);
+
+    private static final Map<Direction, VoxelShape> SHAPES = new EnumMap<>(Direction.class);
+
+    static {
+        for (final Direction facing : Direction.Plane.HORIZONTAL) {
+            SHAPES.put(facing, makeShape(facing));
+        }
+    }
+
+    private static VoxelShape makeShape(final Direction facing) {
+        // Le coin plein occupe l'angle formé par facing et sa direction ANTI-horaire : meta legacy 0 = coin
+        // (x=1,z=0) = NORD-EST, et meta 0 = FACING EAST (BlockCoinToit.onBlockPlacedBy, identique à BlockToit) ;
+        // or EAST ∪ EAST.getCounterClockWise()=NORTH = nord-est. (L'ancien getClockWise() venait de l'hypothèse
+        // « meta 0 = FACING NORTH » de gen_geometry.py, fausse : elle décalait le coin de 90°.)
+        final boolean east = facing == Direction.EAST || facing.getCounterClockWise() == Direction.EAST;
+        final boolean south = facing == Direction.SOUTH || facing.getCounterClockWise() == Direction.SOUTH;
+
+        VoxelShape shape = Shapes.box(0.0D, 0.0D, 0.0D, 1.0D, 0.1D, 1.0D); // dalle de base
+        for (int k = 1; k <= 9; k++) {
+            final double inset = k / 10.0D;
+            shape = Shapes.or(shape, Shapes.box(
+                east ? inset : 0.0D,
+                inset,
+                south ? inset : 0.0D,
+                east ? 1.0D : 1.0D - inset,
+                inset + 0.1D,
+                south ? 1.0D : 1.0D - inset));
+        }
+        return shape.optimize();
+    }
+
+    public CoinDeToitBlock(final BlockBehaviour.Properties properties) {
+        super(properties);
+        this.registerDefaultState(this.stateDefinition.any().setValue(FACING, Direction.NORTH));
+    }
+
+    @Override
+    protected MapCodec<CoinDeToitBlock> codec() {
+        return CODEC;
+    }
+
+    @Override
+    protected VoxelShape getShape(final BlockState state, final BlockGetter level, final BlockPos pos, final CollisionContext context) {
+        return SHAPES.get(state.getValue(FACING));
+    }
+
+    @Override
+    public BlockState getStateForPlacement(final BlockPlaceContext context) {
+        // Orientation par QUADRANT CLIQUÉ, pas par le yaw : on choisit les 4 coins depuis un même endroit, en
+        // visant le quart de bloc voulu — comme le haut/bas d'un escalier vanilla. Le yaw seul obligeait à
+        // tourner autour du bloc pour changer de coin.
+        //
+        // DIVERGENCE ASSUMÉE vs 1.2.5 (choix utilisateur, 2026-07-14) : BlockCoinToit.onBlockPlacedBy dérivait
+        // du yaw, comme BlockToit. On peut s'en écarter ici SANS trahir la résurrection, parce que ce bloc du
+        // Lot B n'a JAMAIS été déployé (client 2011 perdu) et n'existe sur AUCUNE map -> ni fidélité observable
+        // ni remap Phase 2 à préserver. Le `toit` (204), lui, est sur la map : il garde le yaw de 2011.
+        final Vec3 click = context.getClickLocation();
+        final BlockPos pos = context.getClickedPos();
+        final boolean east = click.x - pos.getX() >= 0.5D;
+        final boolean south = click.z - pos.getZ() >= 0.5D;
+        // Le coin plein occupe FACING ∪ FACING.getCounterClockWise() (cf. makeShape), d'où :
+        // NE -> EAST, SE -> SOUTH, SW -> WEST, NW -> NORTH.
+        final Direction facing = east
+                ? (south ? Direction.SOUTH : Direction.EAST)
+                : (south ? Direction.WEST : Direction.NORTH);
+        return this.defaultBlockState().setValue(FACING, facing);
+    }
+
+    @Override
+    protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
+        builder.add(FACING);
+    }
+}
