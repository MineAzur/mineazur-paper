+package net.minecraft.world.level.block;
+
+import com.mojang.serialization.MapCodec;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.util.RandomSource;
+import net.minecraft.util.StringRepresentable;
+import net.minecraft.world.item.context.BlockPlaceContext;
+import net.minecraft.world.level.BlockGetter;
+import net.minecraft.world.level.LevelReader;
+import net.minecraft.world.level.ScheduledTickAccess;
+import net.minecraft.world.level.block.state.BlockBehaviour;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.block.state.StateDefinition;
+import net.minecraft.world.level.block.state.properties.EnumProperty;
+import net.minecraft.world.phys.shapes.CollisionContext;
+import net.minecraft.world.phys.shapes.VoxelShape;
+
+// MineAzur — bloc CUSTOM "sang" (mineazur:sang). Décal de sang au sol, CONNECTÉ : sa forme émerge du voisinage.
+//
+// Modèle par MASQUE des 4 voisins ORTHOGONAUX (16 états). Chaque état = une combinaison de voisins N/S/E/O ;
+// sa texture est opaque jusqu'au bord côté voisin (raccord net) et organique côté ouvert -> une mare continue
+// de taille quelconque, sans couture. Le masque ne dépendant QUE des 4 faces, updateShape (qui se déclenche
+// sur ces faces) suffit à la re-résolution — pas besoin de propagation diagonale.
+//
+// ⚠️ MIROIR STRICT de com.mineazur.client.SangBlock. L'ORDRE de déclaration de l'enum Forme (= ordre du masque
+// 0..15) DOIT être identique des deux côtés, sinon les stateIds de palette divergent (I3).
+//
+// Plat, non-solide, traversable (noCollision) : on marche dessus comme sur une peinture au sol.
+public class SangBlock extends Block {
+    public static final MapCodec<SangBlock> CODEC = simpleCodec(SangBlock::new);
+
+    // Forme = masque des voisins. ORDRE = valeur du masque 0..15 (N=1, S=2, E=4, W=8). Le nom sérialisé liste
+    // les côtés CONNECTÉS dans l'ordre NSEW (ou "none"), et sert de clé texture/modèle côté client.
+    public enum Forme implements StringRepresentable {
+        NONE("none", 0),
+        N("n", 1),
+        S("s", 2),
+        NS("ns", 3),
+        E("e", 4),
+        NE("ne", 5),
+        SE("se", 6),
+        NSE("nse", 7),
+        W("w", 8),
+        NW("nw", 9),
+        SW("sw", 10),
+        NSW("nsw", 11),
+        EW("ew", 12),
+        NEW("new", 13),
+        SEW("sew", 14),
+        NSEW("nsew", 15);
+
+        private final String name;
+        private final int mask;
+
+        Forme(final String name, final int mask) {
+            this.name = name;
+            this.mask = mask;
+        }
+
+        @Override
+        public String getSerializedName() {
+            return this.name;
+        }
+    }
+
+    private static final Forme[] BY_MASK = new Forme[16];
+
+    static {
+        for (final Forme f : Forme.values()) {
+            BY_MASK[f.mask] = f;
+        }
+    }
+
+    public static final EnumProperty<Forme> FORME = EnumProperty.create("forme", Forme.class);
+
+    // Contour de sélection plat (0.5 px). La COLLISION est vide (noCollision, propriétés).
+    private static final VoxelShape SHAPE = Block.column(16.0, 0.0, 0.5);
+
+    public SangBlock(final BlockBehaviour.Properties properties) {
+        super(properties);
+        this.registerDefaultState(this.stateDefinition.any().setValue(FORME, Forme.NONE));
+    }
+
+    @Override
+    protected MapCodec<SangBlock> codec() {
+        return CODEC;
+    }
+
+    @Override
+    protected VoxelShape getShape(final BlockState state, final BlockGetter level, final BlockPos pos, final CollisionContext context) {
+        return SHAPE;
+    }
+
+    // Masque des 4 voisins orthogonaux de même altitude qui sont du sang.
+    private static Forme resolve(final BlockGetter level, final BlockPos pos, final Block self) {
+        int mask = 0;
+        if (level.getBlockState(pos.north()).is(self)) {
+            mask |= 1;
+        }
+        if (level.getBlockState(pos.south()).is(self)) {
+            mask |= 2;
+        }
+        if (level.getBlockState(pos.east()).is(self)) {
+            mask |= 4;
+        }
+        if (level.getBlockState(pos.west()).is(self)) {
+            mask |= 8;
+        }
+        return BY_MASK[mask];
+    }
+
+    @Override
+    public BlockState getStateForPlacement(final BlockPlaceContext context) {
+        return this.defaultBlockState().setValue(FORME, resolve(context.getLevel(), context.getClickedPos(), this));
+    }
+
+    @Override
+    protected BlockState updateShape(
+        final BlockState state,
+        final LevelReader level,
+        final ScheduledTickAccess ticks,
+        final BlockPos pos,
+        final Direction directionToNeighbour,
+        final BlockPos neighbourPos,
+        final BlockState neighbourState,
+        final RandomSource random
+    ) {
+        // Support retiré sous le bloc -> disparaît (comme redstone/tapis ; le drop manuel passe par la loot table).
+        if (!state.canSurvive(level, pos)) {
+            return Blocks.AIR.defaultBlockState();
+        }
+        // Un voisin de sang (une des 4 faces) posé/cassé -> recalculer le masque.
+        return state.setValue(FORME, resolve(level, pos, this));
+    }
+
+    @Override
+    public boolean canSurvive(final BlockState state, final LevelReader level, final BlockPos pos) {
+        final BlockPos below = pos.below();
+        return level.getBlockState(below).isFaceSturdy(level, below, Direction.UP);
+    }
+
+    @Override
+    protected void createBlockStateDefinition(final StateDefinition.Builder<Block, BlockState> builder) {
+        builder.add(FORME);
+    }
+}
