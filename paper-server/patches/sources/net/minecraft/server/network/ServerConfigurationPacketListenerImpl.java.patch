+    @Override
+    public void handleCustomPayload(net.minecraft.network.protocol.common.ServerboundCustomPayloadPacket packet) {
+        // MineAzur — gate serveur : capter le handshake du mod client (mineazur:hello). Tout payload serverbound
+        // arrive en DiscardedPayload(id, byte[]) → on lit les octets et on valide la version.
+        if (packet.payload() instanceof net.minecraft.network.protocol.common.custom.DiscardedPayload dp
+                && io.papermc.paper.mineazur.MineazurHandshake.HELLO_CHANNEL.equals(dp.id())) {
+            final io.papermc.paper.mineazur.MineazurHandshake.Result r =
+                io.papermc.paper.mineazur.MineazurHandshake.check(dp.data());
+            switch (r.status()) {
+                case OK -> {
+                    this.mineazurHelloOk = true;
+                    LOGGER.info("MineAzur: handshake mod client reçu (version {}) — join autorisé.", r.modVersion());
+                }
+                case BAD_VERSION -> {
+                    LOGGER.info("MineAzur: version de mod incompatible ({}) — refus.", r.modVersion());
+                    this.disconnect(Component.literal(io.papermc.paper.mineazur.MineazurConfig.get().kickBadVersion()));
+                }
+                case MALFORMED -> LOGGER.warn("MineAzur: handshake mineazur:hello malformé — ignoré.");
+            }
+            return;
+        }
+        super.handleCustomPayload(packet);
+    }
